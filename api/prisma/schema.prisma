// Ticketly Prisma schema
// The Better Auth tables below can be regenerated with `npx auth generate`
// (adjust if the current Better Auth version's shape differs).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Better Auth core tables
// ------------------------------------------------------------------

model User {
  id            String    @id @unique
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  // admin plugin
  role          Role      @default(agent)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions        Session[]
  accounts        Account[]
  assignedTickets Ticket[]  @relation("AssignedTickets")
  sentMessages    Message[]
  drafts          Draft[]
  notifications   Notification[]
  pushTokens      PushToken[]
  activitiesAuthored TicketActivity[] @relation("ActivityActors")
}

model Session {
  id             String   @id @unique
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String? // admin plugin: the user being impersonated, if any
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @unique
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @unique
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------------
// App models
// ------------------------------------------------------------------

// User roles. Lowercase values match what Better Auth's admin plugin writes.
enum Role {
  admin
  agent
}

enum TicketStatus {
  NEW
  PROCESSING
  OPEN
  AWAITING_STUDENT
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
  SPAM
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

// Who authored a message: the staff agent or the ticket requester (customer).
// Mirrors the shared `messageSenderTypeEnum`.
enum MessageSenderType {
  agent
  customer
}

// One entry in a ticket's activity log (timeline). Mirrors the shared
// `ticketActivityTypeSchema`; keep the two in sync (the codebase convention for
// every closed enum set).
enum TicketActivityType {
  ticket_created
  customer_replied
  agent_replied
  ai_replied
  status_changed
  priority_changed
  category_changed
  assignee_changed
}

model Ticket {
  id             Int            @id @default(autoincrement())
  subject        String
  status         TicketStatus   @default(NEW)
  category       TicketCategory?
  priority       Priority       @default(NORMAL)
  requesterEmail String
  requesterName  String
  messageId      String?        @unique // RFC822 Message-ID of the originating inbound email
  assigneeId     String?
  assignee       User?          @relation("AssignedTickets", fields: [assigneeId], references: [id])
  messages       Message[]
  drafts         Draft[]
  notifications  Notification[]
  activities     TicketActivity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime? // Set when status first reaches RESOLVED/CLOSED; null until then.

  @@index([status])
  @@index([assigneeId])
  @@index([requesterEmail])
  @@map("tickets")
}

model Message {
  id          String   @id @default(uuid())
  ticketId    Int
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction   String // "inbound" | "outbound"
  senderType  MessageSenderType // who authored this message (agent | customer)
  fromEmail   String
  toEmail     String
  subject     String?
  bodyText    String
  bodyHtml    String?
  messageId   String?  @unique
  inReplyTo   String?
  attachments Json?
  senderId    String?
  sender      User?    @relation(fields: [senderId], references: [id])
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@map("messages")
}

model KbArticle {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  content   String
  published Boolean   @default(false)
  chunks    KbChunk[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("kb_articles")
}

model KbChunk {
  id        String                       @id @default(uuid())
  articleId String
  article   KbArticle                    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  content   String
  // pgvector embedding (1024-dim, Zhipu embedding-3). Prisma can't natively type
  // `vector`, so it's declared Unsupported; the column + the `vector` extension
  // are created via a raw SQL migration in Phase 4 (RAG). Search uses $queryRaw.
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())

  @@index([articleId])
  @@map("kb_chunks")
}

model Draft {
  id        String   @id @default(uuid())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  bodyText  String
  citations Json? // DraftCitation[] (chunkId, articleId, articleTitle, snippet)
  model     String?
  status    String   @default("pending") // pending | edited | sent | rejected
  agentId   String?
  agent     User?    @relation(fields: [agentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@map("drafts")
}

// In-app notifications surfaced through the navbar bell. One row per recipient
// (fan-out happens at event time): admins always get a copy, the human assignee
// gets a copy when the ticket is theirs. `type` is a plain String constrained at
// the app layer to "new_ticket" | "new_message" (mirrors `notificationTypeSchema`
// in shared). `readAt` null = unread (drives the bell badge count).
model Notification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // "new_ticket" | "new_message"
  ticketId      Int
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Snapshots captured at fan-out time so the feed renders without a join.
  ticketSubject String
  requesterName String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  // Drives "list this user's notifications" and "count their unread" — both filter
  // on userId (+ readAt), so the composite index covers both hot paths.
  @@index([userId, readAt])
  @@index([ticketId])
  @@map("notifications")
}

// An Expo push token registered by a user's device, used to deliver mobile push
// notifications when the app is closed/backgrounded (the SSE realtime stream only
// reaches an open app). `token` is globally unique — a device is one physical
// install, so on re-login (even as a different user) the row is upserted in place
// and `userId` is reassigned rather than creating a duplicate. Cascade-deleted with
// the user so a deleted account stops receiving pushes. `platform` is a plain
// String constrained at the app layer to "ios" | "android" (mirrors the
// `Notification.type` convention).
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Drives the "fetch tokens for these recipient users" lookup at fan-out time.
  @@index([userId])
  @@map("push_tokens")
}

// One entry in a ticket's lifecycle timeline — created when it arrived, each
// reply (customer / agent / AI), and every status / priority / category /
// assignee change. Written inline at each mutation site (best-effort, never
// rolls back the real write) and read newest-first on the detail page.
//
// `actorUserId` is the staff user who caused the event (null for system / AI /
// customer events). It carries no `onDelete` (default NoAction) so a deleted
// agent's past actions survive — the `actorName` snapshot keeps the feed
// renderable without a join. `changeField`/`changeFrom`/`changeTo` are populated
// only for `*_changed` events; null otherwise.
model TicketActivity {
  id          String             @id @default(uuid())
  ticketId    Int
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type        TicketActivityType
  actorUserId String?
  actor       User?              @relation("ActivityActors", fields: [actorUserId], references: [id])
  actorName   String? // snapshot so the feed renders without a join
  changeField String? // "status" | "priority" | "category" | "assignee"
  changeFrom  String?
  changeTo    String?
  createdAt   DateTime           @default(now())

  // The feed query: a ticket's activity, newest-first, scoped by ticketId.
  @@index([ticketId, createdAt])
  @@index([actorUserId])
  @@map("ticket_activities")
}
