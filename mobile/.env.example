# Full backend origin (no /api suffix). Unlike the web, there is no dev proxy on
# a device/simulator, so this must be reachable from the app:
#   - iOS simulator: http://localhost:3000
#   - Physical device:  http://<your-dev-machine-LAN-IP>:3000
# In production set this to the Railway HTTPS URL (same origin the web app uses).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional — Sentry for React Native. Leave blank to disable (mirrors the web,
# which inits Sentry only when a DSN is present).
EXPO_PUBLIC_SENTRY_DSN=
