# Server
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Database — Neon Postgres with the pgvector extension enabled.
DATABASE_URL="postgresql://user:password@host:5432/ticketly?schema=public"

# Better Auth (reads BETTER_AUTH_SECRET from env automatically)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Bootstrap admin — used by `npm run db:seed`.
# The seed refuses known-default / <12-char passwords, so set a strong one.
SEED_ADMIN_EMAIL="admin@ticketly.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-random-password"

# Inbound email — dev/test webhook shared secret, constant-time checked.
# Used by ONE endpoint, fail-closed (403) if unset:
#   - JSON webhook: POST /api/channels/email/inbound  (X-Webhook-Token header)
#       a local testing harness sets the header to this value to simulate an
#       inbound email without a real provider.
# Production inbound runs through Resend (below), which authenticates with a
# Svix signature (RESEND_WEBHOOK_SECRET), not this token. Generate a long random
# string.
INBOUND_EMAIL_WEBHOOK_TOKEN="replace-with-a-long-random-token"

# Email — Resend (https://resend.com). One API key serves BOTH directions:
# outbound sends (TicketsService.reply() + the AI auto-resolve reply) and the
# inbound fetch (resend.emails.receiving.get, called from the inbound webhook).
# When RESEND_API_KEY is unset, outbound email is disabled and replies persist
# in-thread only (a warning is logged) — the app still runs. MAIL_FROM must be a
# Resend-verified sender: authenticate your domain in the dashboard, or use the
# free *.resend.app subdomain to start. Each send carries a generated Message-ID
# + In-Reply-To/References so a customer's reply threads back onto the same
# ticket via the inbound webhook.
RESEND_API_KEY=""
# Svix signing secret for the Resend inbound webhook. Copy it from
# Resend -> Webhooks -> your webhook. The inbound handler verifies every
# email.received event's signature against this; fail-closed (401) if unset or
# mismatched. Register the webhook at:
#   POST https://<api-origin>/api/channels/email/inbound/resend  (event: email.received)
RESEND_WEBHOOK_SECRET=""
MAIL_FROM="support@ticketly.local"
MAIL_FROM_NAME="Ticketly Support"

# AI provider via its OpenAI-compatible chat endpoint (powers reply polish).
# Set AI_API_KEY for your provider. Override AI_BASE_URL / AI_MODEL to switch
# providers or models without a code change; defaults shown are OpenRouter. The
# polish feature returns 502 until AI_API_KEY is set.
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="openai/gpt-5-nano"

# Sentry — error logging. Leave blank in local dev to disable (the SDK is a
# no-op when unset). Get the DSN from Sentry → Project Settings → Client Keys.
SENTRY_DSN=""
