# Optional. In dev, /api is proxied to the backend (see vite.config.ts), so leave blank.
# Set this only when frontend and API are on different origins (e.g. production).
VITE_API_URL=

# Sentry — error logging. VITE_SENTRY_DSN is public (client DSNs are safe to
# expose by design). Leave blank locally to disable (the SDK is a no-op when
# unset).
VITE_SENTRY_DSN=

# Source-map upload — BUILD-TIME ONLY, set in CI, never VITE_-prefixed (the auth
# token is a secret and must not ship to the client). When SENTRY_AUTH_TOKEN is
# unset, vite build behaves exactly as before (no upload, no .map files emitted).
#   SENTRY_AUTH_TOKEN=   SENTRY_ORG=   SENTRY_PROJECT=
