# Server
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Database — Neon Postgres with the pgvector extension enabled.
DATABASE_URL="postgresql://user:password@host:5432/ticketly?schema=public"

# Better Auth (reads BETTER_AUTH_SECRET from env automatically)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Bootstrap admin — used by `npm run db:seed`.
# The seed refuses known-default / <12-char passwords, so set a strong one.
SEED_ADMIN_EMAIL="admin@ticketly.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-random-password"

# Inbound email webhook — shared secret checked (constant-time) against the
# X-Webhook-Token header on POST /api/channels/email/inbound. Generate a long
# random string. If unset, the webhook rejects all requests (fail-closed).
INBOUND_EMAIL_WEBHOOK_TOKEN="replace-with-a-long-random-token"

# AI provider via its OpenAI-compatible chat endpoint (powers reply polish).
# Set AI_API_KEY for your provider. Override AI_BASE_URL / AI_MODEL to switch
# providers or models without a code change; defaults shown are Zhipu GLM. The
# polish feature returns 502 until AI_API_KEY is set.
AI_API_KEY=""
AI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
AI_MODEL="glm-4.7-flash"
